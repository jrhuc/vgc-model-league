{
  "name": "vgcbench",
  "version": "0.1.0",
  "description": "LLM competitive Pokémon benchmark on the real Showdown simulator",
  "private": true,
  "type": "module",
  "bin": {
    "vgcbench": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "biome check src tools tests",
    "check:fix": "biome check --write src tools tests",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "vgcbench": "node dist/src/cli.js",
    "build-pool": "node dist/tools/build-pool.js",
    "capture-requests": "node dist/tools/capture-requests.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@google/genai": "^2.11.0",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "openai": "^6.47.0",
    "p-limit": "^7.3.0",
    "pokemon-showdown": "file:pokemon-showdown",
    "seedrandom": "^3.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@types/node": "^26.1.1",
    "@types/seedrandom": "^3.0.8",
    "typescript": "^7.0.2"
  }
}
