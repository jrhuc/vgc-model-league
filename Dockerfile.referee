# syntax=docker/dockerfile:1.7
FROM node:24.18.1-bookworm@sha256:19cd848a0e073d34bd8cd5545a1b6b4d28489b3e3b607366621ced442bd5f6b4 AS build

WORKDIR /build
RUN corepack enable && corepack prepare pnpm@11.11.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
RUN pnpm install --frozen-lockfile
COPY showdown.lock.json ./
COPY tools/setup-showdown.mjs ./tools/
RUN node tools/setup-showdown.mjs
COPY tsconfig.json tsconfig.frozen-circuit.json ./
COPY src/ src/
COPY tools/frozen-circuit-referee.ts ./tools/
RUN pnpm exec tsc -p tsconfig.frozen-circuit.json

FROM node:24.18.1-bookworm@sha256:19cd848a0e073d34bd8cd5545a1b6b4d28489b3e3b607366621ced442bd5f6b4 AS production-dependencies

WORKDIR /deps
RUN corepack enable && corepack prepare pnpm@11.11.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
RUN pnpm install --prod --frozen-lockfile

FROM node:24.18.1-bookworm-slim@sha256:235600a8101ab264e117b1768e925532262668dc9b581ef1dd7d96ced463b8e7 AS runtime

ENV NODE_ENV=production \
    VGC_LEAGUE_PS=/opt/vgc-circuit/pokemon-showdown
WORKDIR /opt/vgc-circuit

COPY --from=production-dependencies --chown=node:node /deps/node_modules ./node_modules
COPY --from=build --chown=node:node /build/dist-circuit ./dist-circuit
COPY --from=build --chown=node:node /build/pokemon-showdown/dist ./pokemon-showdown/dist
COPY --from=build --chown=node:node /build/pokemon-showdown/node_modules ./pokemon-showdown/node_modules
COPY --from=build --chown=node:node /build/pokemon-showdown/package.json ./pokemon-showdown/package.json
COPY --from=build --chown=node:node /build/pokemon-showdown/LICENSE ./pokemon-showdown/LICENSE
COPY --chown=node:node LICENSE package.json showdown.lock.json ./
COPY --chown=node:node boards/regmb-202607.json boards/regmb-202607.json
COPY --chown=node:node \
    teams/vr-aug26-top8/pool.json \
    teams/vr-aug26-top8/sources.json \
    teams/vr-aug26-top8/spreads.json \
    teams/vr-aug26-top8/*.team \
    ./teams/vr-aug26-top8/
COPY --chmod=0555 tools/vgc-circuit-referee /usr/local/bin/vgc-circuit-referee

USER node
ENTRYPOINT ["/usr/local/bin/vgc-circuit-referee"]
