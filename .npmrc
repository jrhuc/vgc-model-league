# npm's config, not pnpm's. pnpm ignores every key below; its equivalents live
# in pnpm-workspace.yaml. These are load-bearing because tools/setup-showdown.mjs
# installs Pokemon Showdown with npm, so deleting them as "redundant with pnpm"
# would leave that path unguarded. min-release-age is in days here and minutes
# in pnpm-workspace.yaml.
min-release-age=7
registry=https://registry.npmjs.org/
ignore-scripts=true
strict-allow-scripts=true
yes=false
save-exact=true
allow-git=none
allow-remote=none
allow-file=none
allow-directory=none
engine-strict=true
audit=true
audit-level=moderate
strict-ssl=true
